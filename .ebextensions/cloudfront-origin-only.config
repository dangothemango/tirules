# The site runs on a single instance (no load balancer) behind CloudFront. Only CloudFront may
# reach it: port 80 is open to AWS's CloudFront origin-facing prefix list and nothing else.
# This replaces Elastic Beanstalk's default rule (port 80 from anywhere).
Resources:
  AWSEBSecurityGroup:
    Type: AWS::EC2::SecurityGroup
    Properties:
      SecurityGroupIngress:
        - IpProtocol: tcp
          FromPort: 80
          ToPort: 80
          SourcePrefixListId: pl-3b927c52
